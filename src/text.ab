// Line breaking over any font: the caller says how wide a span of text is and where a
// grapheme cluster ends; this breaks text into lines no wider than a width. A renderer
// with real fonts answers from its glyph metrics, a backend without them from width
// tables (TableFont), a test from a fixed advance.

import "abla/float"

/**
 * What wrapping needs from the fonts. A face is the platform's handle for a font at a
 * size and weight (from `face`). Spans are byte offsets into UTF-8 text.
 */
interface TextFont {
    /** The face for a CSS font family list at `size` px and `weight` (400 regular, 700 bold). */
    fun face(family: string, size: f64, weight: int): int
    /** The width of bytes [start, end) of `text` in `face`, drawn as one run. */
    fun width(face: int, text: string, start: int, end: int): f64
    /** Where the grapheme cluster that starts at byte `i` ends. */
    fun clusterEnd(text: string, i: int): int
    /** The height of one line of `face`. */
    fun lineHeight(face: int): f64
}

/**
 * Wrapped lines: byte spans of the text, each line's width, the widest. `cut`: lines were
 * dropped past maxLines; `ellipsis`: the last line then ends with "…" (its width includes it).
 */
class TextLines(val starts: array<int>, val ends: array<int>, val widths: array<f64>, var widest: f64, var cut: bool, var ellipsis: bool = false)

fun textLines(): TextLines = TextLines([], [], [], 0.0, false)

val TEXT_ELLIPSIS = "…"


/**
 * Break `text` into lines no wider than `maxWidth`: at spaces where it can, inside a word
 * only where the word alone is wider, and at every '\n'. A line is measured whole (the span
 * from its start), so fonts that round a run's width wrap as they measure. With `maxLines`
 * > 0 the lines after it are dropped, `cut` is set and the last kept line ends in an
 * ellipsis that fits; one line wider than the room (maxLines 1) is ellipsized too. Trailing
 * spaces don't count toward a line's width.
 */
fun textWrap(text: string, face: int, maxWidth: f64, maxLines: int, var font: TextFont, var out: TextLines): void {
    out.starts.clear()
    out.ends.clear()
    out.widths.clear()
    out.widest = 0.0
    out.cut = false
    out.ellipsis = false
    var lineStart = 0
    var i = 0
    var lastBreak = -1
    while (i <= text.size) {
        if (maxLines > 0 && out.starts.size >= maxLines) {
            out.cut = lineStart < text.size
            if (out.cut) textEllipsize(text, face, maxWidth, font, out)
            return
        }
        val b = if (i < text.size) text[i] else 10
        if (b == 10) {
            textLine(out, text, face, lineStart, i, font)
            lineStart = i + 1
            lastBreak = -1
            i = i + 1
        } else {
            val next = font.clusterEnd(text, i)
            if (b != 32 && i > lineStart && font.width(face, text, lineStart, next) > maxWidth + 0.001) {
                val atSpace = lastBreak > lineStart
                textLine(out, text, face, lineStart, if (atSpace) lastBreak else i, font)
                lineStart = if (atSpace) lastBreak + 1 else i
                lastBreak = -1
            } else {
                if (b == 32) lastBreak = i
                i = next
            }
        }
    }
    if (maxLines == 1 && out.starts.size == 1 && out.widths[0] > maxWidth + 0.001) textEllipsize(text, face, maxWidth, font, out)
    return
}

/** End the last line with "…", dropping characters (and then spaces) until it fits. */
fun textEllipsize(text: string, face: int, maxWidth: f64, var font: TextFont, var out: TextLines): void {
    val last = out.starts.size - 1
    if (last < 0) return
    val start = out.starts[last]
    var end = if (out.cut) text.size else out.ends[last]
    // The rest of the text joins the last line before it is cut back.
    if (out.cut) {
        var stop = start
        while (stop < text.size && text[stop] != 10) stop = stop + 1
        end = stop
    }
    val dots = font.width(face, TEXT_ELLIPSIS, 0, TEXT_ELLIPSIS.size)
    while (end > start && font.width(face, text, start, end) + dots > maxWidth + 0.001) {
        var back = end - 1
        while (back > start && text[back] >= 128 && text[back] < 192) back = back - 1
        end = back
    }
    while (end > start && text[end - 1] == 32) end = end - 1
    out.ends[last] = end
    val w = (if (end > start) font.width(face, text, start, end) else 0.0) + dots
    out.widths[last] = w
    out.ellipsis = true
    out.widest = 0.0
    for (x in out.widths) if (x > out.widest) out.widest = x
    return
}

fun textLine(var out: TextLines, text: string, face: int, start: int, end: int, var font: TextFont): void {
    var e = end
    while (e > start && text[e - 1] == 32) e = e - 1
    val w = if (e > start) font.width(face, text, start, e) else 0.0
    out.starts.append(start)
    out.ends.append(e)
    out.widths.append(w)
    if (w > out.widest) out.widest = w
    return
}

/** UTF-8: where the code point starting at byte `i` ends (a fallback cluster rule). */
fun textCodePointEnd(text: string, i: int): int {
    val b = text[i]
    val n = if (b >= 240) 4 else if (b >= 224) 3 else if (b >= 192) 2 else 1
    if (i + n > text.size) text.size else i + n
}

/**
 * A font from width tables, for measuring without a renderer (a server laying out HTML, a
 * test): advances in 1/1000 em by code point for a few weights, one em for code points
 * past U+2000 that aren't listed (emoji, CJK) and `fallback` for the others. A run's width
 * is its advances summed exactly, then rounded up to a whole pixel when `whole` is set (as
 * abla-one's width tables are read). A face is a size and a weight's table.
 */
class TableFont(
    val codes: Map<int, int>,           // code point → its column in each table
    val weights: array<int>,            // the weight each table is for (400, 500…)
    val tables: array<array<int>>,      // advances by column, one table per weight
    val ascent: f64, val descent: f64,  // per em
    val fallback: int, val whole: bool,
    val faceSize: array<f64>, val faceTable: array<int>
) : TextFont {
    fun face(family: string, size: f64, weight: int): int {
        var table = 0
        for (i in 0 until weights.size) if (weights[i] <= weight) table = i
        for (i in 0 until faceSize.size) if (faceSize[i] == size && faceTable[i] == table) return i
        faceSize.append(size)
        faceTable.append(table)
        faceSize.size - 1
    }
    fun width(face: int, text: string, start: int, end: int): f64 {
        val table = tables[faceTable[face]]
        var milli = 0.0
        var i = start
        while (i < end) {
            val n = textCodePointEnd(text, i)
            val code = textCodePoint(text, i)
            val column = codes.get(code) ?? -1
            val advance = if (column >= 0) table[column] else if (code > 0x2000) 1000 else fallback
            milli = milli + f64FromInt(advance) * faceSize[face]
            i = n
        }
        if (whole) f64FromInt((f64ToInt(milli) + 999) / 1000) else milli / 1000.0
    }
    fun clusterEnd(text: string, i: int): int = textCodePointEnd(text, i)
    fun lineHeight(face: int): f64 = (ascent + descent) * faceSize[face]
}

/** A TableFont from code points and per-weight advance tables (1/1000 em). */
fun tableFont(codes: array<int>, weights: array<int>, tables: array<array<int>>, ascent: f64, descent: f64, fallback: int, whole: bool): TableFont {
    val index: Map<int, int> = Map()
    for (i in 0 until codes.size) index.set(codes[i], i)
    TableFont(index, weights, tables, ascent, descent, fallback, whole, [], [])
}

/** The code point starting at byte `i` of UTF-8 text. */
fun textCodePoint(text: string, i: int): int {
    val b = text[i]
    if (b < 128) return b
    if (b >= 240 && i + 3 < text.size) return ((b - 240) * 262144) + ((text[i + 1] - 128) * 4096) + ((text[i + 2] - 128) * 64) + (text[i + 3] - 128)
    if (b >= 224 && i + 2 < text.size) return ((b - 224) * 4096) + ((text[i + 1] - 128) * 64) + (text[i + 2] - 128)
    if (b >= 192 && i + 1 < text.size) return ((b - 192) * 64) + (text[i + 1] - 128)
    b
}
