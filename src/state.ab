// State: values whose changes are seen. One primitive serves two ways of using it.
//
// - An app re-renders when anything changed: every write that changes a value moves the
//   global revision (`stateRevision()`), as abla-one's run loop expects.
// - A retained tree re-renders only what read the value: while a scope renders (a
//   component, by a scope id from stateNewScope(); `stateRead(scope)` ... `stateReadEnd()`),
//   each State it reads
//   remembers it, and a write that changes the value queues those scopes
//   (`stateTakeChanged()`).
// - A game polls one value without any render: `^name.version` moves on each change.
//
//   class Settings(var open: bool by State(false), var volume: f64 by State(0.8))
//   settings.open = true                // changed: revision + 1, readers queued
//   settings.^volume.version            // how many times volume changed
//   settings.^volume.peek()             // read without subscribing
//
// Writes that keep the value (`==`) change nothing. State holds plain values (numbers,
// booleans, strings); keep a collection beside a State that counts its changes
// (`var itemsChanged by State(0)`, bumped after each edit) and read that State where the
// collection is rendered.

var stateRevisionCount = 0

/** Moves on every change of any State (and every `stateTouchAll`). */
fun stateRevision(): int = stateRevisionCount

/** The scope rendering now (its reads subscribe it), -1 when none. */
var stateReader = -1

// Scopes queued by changes since the last stateTakeChanged, and which are queued (looked up,
// never iterated: the list keeps the order).
val stateChangedScopes: array<int> = []
val stateQueued: Map<int, bool> = Map()

// Scope ids are never reused, so two trees, or a node slot taken again, never share one.
var stateScopeCount = 0
// Scopes that ended: nothing renders under them again, and States drop them as readers.
val stateEnded: Map<int, bool> = Map()

/** A new scope id, unique for the program's life. */
fun stateNewScope(): int {
    stateScopeCount = stateScopeCount + 1
    stateScopeCount
}

/** Scope `scope` is gone (its component was removed): changes no longer queue it. */
fun stateEndScope(scope: int): void {
    stateEnded.set(scope, true)
    // Swept when the scopes ended since the last sweep reach a quarter of the links a sweep
    // walks: each ended scope pays a few steps of it.
    stateEndedSinceSweep = stateEndedSinceSweep + 1
    if (stateEndedSinceSweep >= 64 && stateEndedSinceSweep * 4 >= stateLinkScope.size) stateSweep()
    return
}

fun stateScopeLive(scope: int): bool = !(stateEnded.get(scope) ?? false)

/** Start recording reads for `scope` (an id >= 0 the caller owns); returns the previous reader. */
fun stateRead(scope: int): int {
    val previous = stateReader
    stateReader = scope
    previous
}

/** Stop recording, back to `previous` (stateRead's result). */
fun stateReadEnd(previous: int): void {
    stateReader = previous
    return
}

fun stateQueue(scope: int): void {
    if (scope < 0 || !stateScopeLive(scope) || (stateQueued.get(scope) ?? false)) return
    stateQueued.set(scope, true)
    stateChangedScopes.append(scope)
    return
}

/** The scopes queued since the last call, in the order they were queued (each once). */
fun stateTakeChanged(var into: array<int>): void {
    into.clear()
    for (s in stateChangedScopes) {
        into.append(s)
        stateQueued.set(s, false)
    }
    stateChangedScopes.clear()
    return
}

/** Is anything queued? */
fun stateHasChanges(): bool = stateChangedScopes.size > 0

/** Something outside any State changed: move the revision (abla-one's oneInvalidate). */
fun stateTouchAll(): void {
    stateRevisionCount = stateRevisionCount + 1
    return
}

// Who read each State, kept apart from the State itself: a read only notes the reader, so it
// works through any reference (a val, an immutable parameter, a field of an immutable object).
// Per State id, a list of reader scopes in the order they first read it: links in flat arrays
// (scope, the State's id, next, previous), a free list for the links dropped.
val stateHead: array<int> = []      // per State id: its first link, -1 for none
val stateLinkScope: array<int> = [] // -1: a free link
val stateLinkId: array<int> = []
val stateLinkNext: array<int> = []
val stateLinkPrev: array<int> = []
var stateLinkFree = -1
var stateLinksLive = 0
// Scopes ended since the links were last swept: a State that is gone is never touched again,
// so its links to ended scopes are only freed by a sweep.
var stateEndedSinceSweep = 0

/** A new State's id (its slot in the readers' table). */
fun stateNewId(): int {
    stateHead.append(-1)
    stateHead.size - 1
}

/** Note that `scope` read State `id` (once: a second read changes nothing). */
fun stateSubscribe(id: int, scope: int): void {
    var at = stateHead[id]
    var last = -1
    while (at >= 0) {
        if (stateLinkScope[at] == scope) return
        last = at
        at = stateLinkNext[at]
    }
    var link = stateLinkFree
    if (link >= 0) {
        stateLinkFree = stateLinkNext[link]
        stateLinkScope[link] = scope
        stateLinkId[link] = id
        stateLinkNext[link] = -1
        stateLinkPrev[link] = last
    } else {
        link = stateLinkScope.size
        stateLinkScope.append(scope)
        stateLinkId.append(id)
        stateLinkNext.append(-1)
        stateLinkPrev.append(last)
    }
    if (last >= 0) stateLinkNext[last] = link else stateHead[id] = link
    stateLinksLive = stateLinksLive + 1
    return
}

/** Drop `scope` from State `id`'s readers. */
fun stateUnsubscribe(id: int, scope: int): void {
    var at = stateHead[id]
    while (at >= 0) {
        if (stateLinkScope[at] == scope) {
            stateUnlink(at)
            return
        }
        at = stateLinkNext[at]
    }
    return
}

/** Take link `at` out of its State's list and onto the free list. */
fun stateUnlink(at: int): void {
    val prev = stateLinkPrev[at]
    val next = stateLinkNext[at]
    if (prev >= 0) stateLinkNext[prev] = next else stateHead[stateLinkId[at]] = next
    if (next >= 0) stateLinkPrev[next] = prev
    stateLinkScope[at] = -1
    stateLinkId[at] = -1
    stateLinkNext[at] = stateLinkFree
    stateLinkFree = at
    stateLinksLive = stateLinksLive - 1
    return
}

/** State `id` changed: queue its live readers, in order, and drop the ended ones. */
fun stateNotify(id: int): void {
    var at = stateHead[id]
    while (at >= 0) {
        val next = stateLinkNext[at]
        val r = stateLinkScope[at]
        if (stateScopeLive(r)) stateQueue(r) else stateUnlink(at)
        at = next
    }
    return
}

/** How many readers State `id` holds: an ended scope counts until a change or a sweep drops it. */
fun stateReaderCount(id: int): int {
    var count = 0
    var at = stateHead[id]
    while (at >= 0) {
        count = count + 1
        at = stateLinkNext[at]
    }
    count
}

/** Free every link to an ended scope (States that are gone keep theirs until this runs). */
fun stateSweep(): void {
    for (at in 0 until stateLinkScope.size) {
        val r = stateLinkScope[at]
        if (r >= 0 && !stateScopeLive(r)) stateUnlink(at)
    }
    stateEndedSinceSweep = 0
    return
}

/**
 * A value whose changes are seen (see the top of this file). It holds only the value, its
 * version and an id; who read it is kept in a table by that id, so reading needs no mutable
 * reference.
 */
class State<StateValue>(var current: StateValue, val id: int = stateNewId(), var version: int = 0) {
    fun getValue(): StateValue {
        if (stateReader >= 0) stateSubscribe(id, stateReader)
        current
    }

    fun setValue(next: StateValue): void {
        if (next != current) {
            current = next
            this.touch()
        }
        return
    }

    /** The value, without subscribing the scope rendering now. */
    fun peek(): StateValue = current

    /** Count a change made in place, and tell whoever read the value. */
    fun touch(): void {
        version = version + 1
        stateRevisionCount = stateRevisionCount + 1
        stateNotify(id)
        return
    }

    fun subscribe(scope: int): void {
        stateSubscribe(id, scope)
        return
    }

    /** Forget `scope` (it no longer exists). */
    fun unsubscribe(scope: int): void {
        stateUnsubscribe(id, scope)
        return
    }

    /** How many readers it holds (an ended scope until a change or a sweep drops it). */
    fun readerCount(): int = stateReaderCount(id)
}
