// expect: thread.shared-global
// State is confined to one thread: its bookkeeping is process globals, so a thread that makes
// or reads one doesn't compile (the language allows a thread only globals nobody can change).
import "../../src/state.ab"

class Counter(var count: int by Tracked(0))

fun main: int {
    val worker = thread {
        val c = Counter()
        c.count
    }
    await worker
}
