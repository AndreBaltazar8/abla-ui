// Self-checks for the retained tree, its reconciliation, the paint walk, input and the kit.
// Exits 0 when every check passes.

import "abla/io"
import "abla/float"
import "abla/float/text"
import "abla/math"
import "../src/ui.ab"

var failed = 0
var passed = 0

fun check(ok: bool, name: string): void {
    if (ok) passed = passed + 1
    else {
        println("FAIL $name")
        failed = failed + 1
    }
    return
}

fun near(a: f64, b: f64): bool = fabs(a - b) < 0.001

/** 8 px a byte at any size, 20 px lines. */
class Mono() : TextFont {
    fun face(family: string, size: f64, weight: int): int = f64ToInt(size)
    fun width(face: int, text: string, start: int, end: int): f64 = f64FromInt(end - start) * 8.0
    fun clusterEnd(text: string, i: int): int = textCodePointEnd(text, i)
    fun lineHeight(face: int): f64 = 20.0
}

/** A font whose advance can change, as when a font file arrives. */
class Growing(var advance: f64) : TextFont {
    fun face(family: string, size: f64, weight: int): int = 0
    fun width(face: int, text: string, start: int, end: int): f64 = f64FromInt(end - start) * advance
    fun clusterEnd(text: string, i: int): int = textCodePointEnd(text, i)
    fun lineHeight(face: int): f64 = advance * 2.5
}

fun fontsArrive(): void {
    var t = viewTree(themeDefault(), Growing(8.0))
    var r = recorder()
    var e = viewInput()
    val unused = t.mount(text("hello", style()).named("hello"))
    frame(t, e, r)
    val n = t.named("hello")
    check(near(t.flex.w[n], 40.0) && near(t.flex.h[n], 20.0), "text measured with the first font")
    t.texts.font = Growing(10.0)
    t.fontsChanged()
    frame(t, e, r)
    check(near(t.flex.w[n], 50.0) && near(t.flex.h[n], 25.0), "fontsChanged measures text again with the new metrics (${t.flex.w[n]} × ${t.flex.h[n]})")
    return
}

/** Records what is painted. */
class Recorder(var boxes: int, var texts: int, var clips: int, val said: array<string>, val textX: array<f64>, val textY: array<f64>, val boxRgb: array<int>) : ViewPainter {
    fun box(x: f64, y: f64, w: f64, h: f64, look: Look, opacity: f64): void {
        boxes = boxes + 1
        boxRgb.append(look.fill)
        return
    }
    fun text(face: int, t: string, start: int, end: int, x: f64, y: f64, look: Look, opacity: f64): void {
        texts = texts + 1
        said.append(t.slice(start, end))
        textX.append(x)
        textY.append(y)
        return
    }
    fun image(handle: int, x: f64, y: f64, w: f64, h: f64, opacity: f64): void {
        return
    }
    fun clipPush(x: f64, y: f64, w: f64, h: f64): void {
        clips = clips + 1
        return
    }
    fun clipPop(): void {
        return
    }
}

/** Replays every node whose stamp it has seen, and counts. */
class Replayer(val seen: array<int>, var replayed: int, var drawn: int, var calls: int) : ViewPainter {
    fun box(x: f64, y: f64, w: f64, h: f64, look: Look, opacity: f64): void {
        calls = calls + 1
        return
    }
    fun text(face: int, t: string, start: int, end: int, x: f64, y: f64, look: Look, opacity: f64): void {
        calls = calls + 1
        return
    }
    fun image(handle: int, x: f64, y: f64, w: f64, h: f64, opacity: f64): void {
        return
    }
    fun clipPush(x: f64, y: f64, w: f64, h: f64): void {
        return
    }
    fun clipPop(): void {
        return
    }
    fun nodeBegin(node: int, stamp: int, x: f64, y: f64, opacity: f64): bool {
        while (seen.size <= node) seen.append(-1)
        if (seen[node] == stamp) {
            replayed = replayed + 1
            return true
        }
        seen[node] = stamp
        drawn = drawn + 1
        false
    }
}

fun recorder(): Recorder = Recorder(0, 0, 0, [], [], [], [])

fun said(r: Recorder, t: string): int {
    for (i in 0 until r.said.size) if (r.said[i] == t) return i
    -1
}

// ── components ───────────────────────────────────────────────────────────────

/** A component reading a plain State (abla-one's kind): it renders again when the revision moves. */
class PlainModel(var label: string by State("one"))
val plainModel = PlainModel()
var plainRenders = 0
class PlainView() : Component {
    fun render(): El {
        plainRenders = plainRenders + 1
        text(plainModel.label, style()).named("plain")
    }
}
fun makePlainView(): Component = PlainView()

class Model(var count: int by Tracked(0), var itemsRev: int by Tracked(0), var open: bool by Tracked(true),
            var volume: f64 by Tracked(0.5), var shadows: bool by Tracked(false), var tab: int by Tracked(0), var presses: int by Tracked(0))

val model = Model()
val modelItems: array<string> = []

fun setItems(names: array<string>): void {
    modelItems.clear()
    for (n in names) modelItems.append(n)
    model.itemsRev = model.itemsRev + 1
    return
}

class Counter() : Component {
    fun render(): El = column(style().padding(10.0).gap(4.0), [
        text("count ${model.count}", style()).named("count"),
        button("add", style(), { -> model.count = model.count + 1 }).named("add")
    ])
}

class Items() : Component {
    fun render(): El {
        val rows: array<El> = []
        val unusedRev = model.itemsRev
        for (name in modelItems) rows.append(text(name, style()).keyed(name))
        column(style().anchor(FLEX_ANCHOR_TOP_RIGHT, 10.0, 10.0), rows)
    }
}

fun makeCounter(): Component = Counter()
fun makeItems(): Component = Items()
fun makeSettings(): Component = Settings()

var counterRenders = 0
var itemRenders = 0

class Settings() : Component {
    fun render(): El {
        if (!model.open) return box(style().hidden(true), [])
        windowPanel("Settings", { -> model.open = false }, style().width(300.0).anchor(FLEX_ANCHOR_CENTER, 0.0, 0.0), [
            tabs(["Video", "Audio"], model.tab, style(), { i -> model.tab = i }).named("tabs"),
            toggle("Shadows", model.shadows, style(), { on -> model.shadows = on }).named("shadows"),
            slider(model.volume, 0.0, 1.0, style(), { v -> model.volume = v }).named("volume"),
            button("Reset", style(), { -> model.presses = model.presses + 1 }).named("reset").tip("Back to the preset")
        ])
    }
}

fun frame(var t: ViewTree, var e: ViewInput, var r: Recorder): void {
    t.input(e)
    t.update(800.0, 600.0)
    t.paint(r)
    return
}

fun frameWith(var t: ViewTree, var e: ViewInput, var r: Replayer): void {
    t.input(e)
    t.update(800.0, 600.0)
    t.paint(r)
    return
}

fun clearRec(var r: Recorder): void {
    r.boxes = 0
    r.texts = 0
    r.clips = 0
    r.said.clear()
    r.textX.clear()
    r.textY.clear()
    r.boxRgb.clear()
    return
}

fun counting(): void {
    var t = viewTree(themeDefault(), Mono())
    var r = recorder()
    var e = viewInput()
    val unusedCounter = t.mount(comp("counter", makeCounter))
    val unusedItems = t.mount(comp("items", makeItems))
    setItems(["a", "b", "c"])
    frame(t, e, r)
    check(said(r, "count 0") >= 0 && said(r, "add") >= 0, "a mounted component paints its text")
    val count = t.named("count")
    check(count >= 0 && near(t.ax[count], 10.0) && near(t.ay[count], 10.0), "the counter's text sits inside its padding")
    val a = said(r, "a")
    check(a >= 0 && near(r.textX[a], 800.0 - 10.0 - 8.0), "a top-right anchored column sits at the right edge")

    // An unchanged frame: nothing rendered, laid out or resolved; the same paint.
    val boxes = r.boxes
    val texts = r.texts
    t.renders = 0
    t.layouts = 0
    t.resolves = 0
    t.flex.computed = 0
    clearRec(r)
    frame(t, e, r)
    check(t.renders == 0 && t.layouts == 0 && t.resolves == 0 && t.flex.computed == 0, "an unchanged frame renders, lays out and resolves nothing")
    check(r.boxes == boxes && r.texts == texts, "and paints the same")

    // A new window size with nothing else changed: the top-right column follows the edge.
    t.input(e)
    t.update(1000.0, 700.0)
    clearRec(r)
    t.paint(r)
    val moved = said(r, "a")
    check(moved >= 0 && near(r.textX[moved], 1000.0 - 10.0 - 8.0), "a resize lays out again: the top-right column follows the edge (${if (moved >= 0) r.textX[moved] else -1.0})")
    clearRec(r)
    frame(t, e, r)
    val back = said(r, "a")
    check(back >= 0 && near(r.textX[back], 800.0 - 10.0 - 8.0), "and back")

    // A State change re-renders only the component that read it.
    var changes: array<int> = []
    t.takeChanges(changes)
    model.count = 1
    t.renders = 0
    clearRec(r)
    frame(t, e, r)
    check(t.renders == 1 && said(r, "count 1") >= 0, "a change re-renders the component that read it, only it")
    t.takeChanges(changes)
    var props = 0
    var others = 0
    var i = 0
    while (i < changes.size) {
        if (changes[i] == CH_PROPS) props = props + 1 else others = others + 1
        i = i + 3
    }
    check(props == 1 && others == 0 && changes[1] == count, "the change set names the one node that changed")

    // Keyed children: a reorder moves the same nodes.
    val nodeA = t.flex.first[t.flex.next[t.flex.first[t.root]]]
    setItems(["c", "a", "b"])
    frame(t, e, r)
    t.takeChanges(changes)
    var adds = 0
    var moves = 0
    var removes = 0
    i = 0
    while (i < changes.size) {
        if (changes[i] == CH_ADD) adds = adds + 1
        if (changes[i] == CH_MOVE) moves = moves + 1
        if (changes[i] == CH_REMOVE) removes = removes + 1
        i = i + 3
    }
    check(adds == 0 && removes == 0 && moves >= 1, "a keyed reorder moves nodes, adds and removes none")
    val itemsNode = t.flex.next[t.flex.first[t.root]]
    check(t.flex.first[itemsNode] != nodeA && t.flex.next[t.flex.first[itemsNode]] == nodeA, "node 'a' is the same node, now second")
    setItems(["c", "b"])
    frame(t, e, r)
    t.takeChanges(changes)
    check(changes.size == 3 && changes[0] == CH_REMOVE && changes[1] == nodeA, "removing a keyed item removes its node and changes nothing else (${changes.size / 3} records)")

    // Per-frame changes without a render.
    t.renders = 0
    t.setText(count, "count 99")
    t.flex.computed = 0
    frame(t, e, r)
    check(t.renders == 0 && t.flex.computed > 0, "setText lays out again without a render")
    t.flex.computed = 0
    t.setTranslate(count, 5.0, 7.0)
    clearRec(r)
    frame(t, e, r)
    check(t.flex.computed == 0 && near(t.ax[count], 15.0) && near(t.ay[count], 17.0), "setTranslate moves a node with no layout")

    // Input: hover, press and release on the button.
    val add = t.named("add")
    e.x = t.ax[add] + 4.0
    e.y = t.ay[add] + 4.0
    e.time = 1.0
    t.resolves = 0
    frame(t, e, r)
    check(t.hot == add && (t.own[add] & ON_HOVER) != 0, "the pointer over the button makes it hot")
    check(t.resolves >= 1 && t.wantsPointer(), "hovering repaints its look, and the UI takes the pointer")
    e.pressed = true
    e.down = true
    frame(t, e, r)
    e.pressed = false
    check((t.own[add] & ON_PRESSED) != 0 && model.count == 1, "pressed, not yet clicked")
    e.down = false
    e.released = true
    frame(t, e, r)
    e.released = false
    check(model.count == 2, "released over it: clicked")
    frame(t, e, r)
    check(said(r, "count 2") >= 0, "the click's State change shows next frame")
    e.x = -100.0
    frame(t, e, r)
    check(t.hot == -1 && !t.wantsPointer(), "off the UI, the world gets the pointer")

    // Painters that keep what they drew: an unchanged frame replays every node.
    var rp = Replayer([], 0, 0, 0)
    frameWith(t, e, rp)
    rp.replayed = 0
    rp.drawn = 0
    rp.calls = 0
    frameWith(t, e, rp)
    check(rp.drawn == 0 && rp.replayed > 5 && rp.calls == 0, "an unchanged frame replays every node and draws nothing (${rp.drawn} drawn, ${rp.replayed} replayed)")
    e.x = t.ax[add] + 4.0
    e.y = t.ay[add] + 4.0
    frameWith(t, e, rp)
    rp.drawn = 0
    frameWith(t, e, rp)
    t.setText(count, "count 7")
    rp.drawn = 0
    frameWith(t, e, rp)
    check(rp.drawn == 1, "a new text of the same width draws only its node again (${rp.drawn})")
    return
}

fun settings(): void {
    var t = viewTree(themeDefault(), Mono())
    var r = recorder()
    var e = viewInput()
    val unusedSettings = t.mount(comp("settings", makeSettings))
    frame(t, e, r)
    frame(t, e, r)
    check(said(r, "Settings") >= 0 && said(r, "Video") >= 0 && said(r, "Shadows") >= 0 && said(r, "Reset") >= 0, "the window shows its title and parts")
    val volume = t.named("volume")
    check(volume >= 0 && near(t.flex.w[volume], 300.0 - 32.0), "a slider fills the window's body")

    // Drag the slider to three quarters.
    e.x = t.ax[volume] + t.flex.w[volume] * 0.75
    e.y = t.ay[volume] + 5.0
    e.pressed = true
    e.down = true
    frame(t, e, r)
    e.pressed = false
    check(near(model.volume, 0.75), "pressing a slider sets its value (${model.volume})")
    e.x = t.ax[volume] + t.flex.w[volume] * 0.25
    frame(t, e, r)
    check(near(model.volume, 0.25), "dragging follows the pointer")
    e.down = false
    e.released = true
    frame(t, e, r)
    e.released = false

    // Toggle by click.
    val shadows = t.named("shadows")
    e.x = t.ax[shadows] + 5.0
    e.y = t.ay[shadows] + 5.0
    e.pressed = true
    e.down = true
    frame(t, e, r)
    e.pressed = false
    e.down = false
    e.released = true
    frame(t, e, r)
    e.released = false
    check(model.shadows, "clicking a toggle turns it on")
    frame(t, e, r)
    check((t.own[shadows] & ON_SELECTED) != 0, "and it shows as selected")

    // Keyboard: Tab through, activate a tab, step the slider.
    e.x = -100.0
    e.nav = NAV_NEXT
    frame(t, e, r)
    check(t.focused >= 0 && t.focused == t.focusOrder[0], "Tab focuses the first focusable")
    // The close button comes first; Down twice (arrows navigate when asked) reaches the second tab.
    t.navigating = true
    e.nav = NAV_DOWN
    frame(t, e, r)
    frame(t, e, r)
    e.nav = NAV_NONE
    e.activate = true
    frame(t, e, r)
    e.activate = false
    frame(t, e, r)
    t.navigating = false
    check(model.tab == 1, "Down then Enter picks the second tab (tab ${model.tab})")
    // Focus the slider (after tabs ×2 and the toggle, the window's close button is first).
    var guard = 0
    while (t.focused != volume && guard < 10) {
        e.nav = NAV_NEXT
        frame(t, e, r)
        guard = guard + 1
    }
    e.nav = NAV_NONE
    e.right = true
    frame(t, e, r)
    e.right = false
    check(near(model.volume, 0.30), "Right steps a focused slider by a twentieth (${model.volume})")
    e.home = true
    frame(t, e, r)
    e.home = false
    check(near(model.volume, 0.0), "Home jumps to the start")

    // Tooltip after half a second on the button.
    val reset = t.named("reset")
    e.x = t.ax[reset] + 3.0
    e.y = t.ay[reset] + 3.0
    e.time = 10.0
    frame(t, e, r)
    e.time = 10.2
    clearRec(r)
    frame(t, e, r)
    check(said(r, "Back to the preset") < 0, "no tooltip before half a second")
    e.time = 10.6
    clearRec(r)
    frame(t, e, r)
    clearRec(r)
    frame(t, e, r)
    check(said(r, "Back to the preset") >= 0, "the tooltip shows after half a second")

    // Escape closes the topmost window.
    e.cancel = true
    frame(t, e, r)
    e.cancel = false
    check(!model.open && t.focused == -1, "Escape clears focus and closes the window")
    clearRec(r)
    frame(t, e, r)
    check(said(r, "Settings") < 0, "a closed window isn't painted")
    return
}

fun scrollingAndBreakpoints(): void {
    var t = viewTree(themeDefault(), Mono())
    var r = recorder()
    var e = viewInput()
    val rows: array<El> = []
    for (i in 0 until 20) rows.append(text("row $i", style().height(20.0)))
    val unusedList = t.mount(list(style().height(100.0).width(200.0), rows).named("list"))
    val unusedCard = t.mount(box(style().anchor(FLEX_ANCHOR_BOTTOM_LEFT, 0.0, 0.0).width(400.0).upTo(500.0, style().width(200.0)), []).named("card"))
    frame(t, e, r)
    val l = t.named("list")
    check(near(t.flex.h[l], 100.0) && t.flex.contentH[l] > 400.0, "a list keeps its height and scrolls its content")
    check(said(r, "row 0") >= 0 && said(r, "row 19") < 0, "rows outside the view aren't painted")
    e.x = 50.0
    e.y = 50.0
    e.wheelY = 100.0
    frame(t, e, r)
    e.wheelY = 0.0
    clearRec(r)
    frame(t, e, r)
    check(near(t.sy[l], 100.0) && said(r, "row 0") < 0 && said(r, "row 5") >= 0, "the wheel scrolls the list under the pointer")
    e.pressed = true
    e.down = true
    frame(t, e, r)
    e.pressed = false
    e.y = 20.0
    frame(t, e, r)
    check(near(t.sy[l], 130.0), "a drag scrolls it (${t.sy[l]})")
    e.down = false
    e.released = true
    frame(t, e, r)
    e.released = false

    val card = t.named("card")
    check(near(t.flex.w[card], 400.0), "at 800 wide the card is 400")
    t.input(e)
    t.update(480.0, 600.0)
    t.paint(r)
    check(near(t.flex.w[card], 200.0), "up to 500 wide the breakpoint makes it 200")
    return
}

// ── adversarial: nodes that go away while something still points at them ─────

class AdvModel(var showFps: bool by Tracked(true), var showList: bool by Tracked(true), var extra: int by Tracked(0))
val adv = AdvModel()
var advPresses = 0

/** A HUD whose parts come and go: an fps line, a scrolling list, and any number of labels. */
class AdvHud() : Component {
    fun render(): El {
        val kids: array<El> = []
        if (adv.showFps) kids.append(text("60 fps", style()).named("fps").keyed("fps"))
        if (adv.showList) {
            val rows: array<El> = []
            for (i in 0 until 20) rows.append(text("row $i", style().height(20.0)))
            kids.append(list(style().height(100.0).width(200.0), rows).named("advlist").keyed("list"))
        }
        for (i in 0 until adv.extra) kids.append(text("label $i", style()).keyed("label$i"))
        column(style(), kids)
    }
}
fun makeAdvHud(): Component = AdvHud()

class AdvButton() : Component {
    fun render(): El = button("ok", style().width(80.0), { -> advPresses = advPresses + 1 }).named("ok")
}
fun makeAdvButton(): Component = AdvButton()

// ── scopes across trees, stale subscriptions, identities ─────────────────────

class Own(var a: int by Tracked(0), var b: int by Tracked(0), var c: int by Tracked(0))
val own = Own()
var rendersA = 0
var rendersB = 0
var rendersC = 0

class ReadsA() : Component {
    fun render(): El {
        rendersA = rendersA + 1
        text("a ${own.a}", style())
    }
}
class ReadsB() : Component {
    fun render(): El {
        rendersB = rendersB + 1
        text("b ${own.b}", style())
    }
}
class ReadsC() : Component {
    fun render(): El {
        rendersC = rendersC + 1
        text("c ${own.c}", style())
    }
}
fun makeReadsA(): Component = ReadsA()
fun makeReadsB(): Component = ReadsB()
fun makeReadsC(): Component = ReadsC()

class Kids(var keyed: bool by Tracked(false)) : Component {
    fun render(): El = if (!keyed) column(style(), [text("a", style()), text("b", style()).named("kid-b")])
        else column(style(), [text("c", style()).keyed("#1"), text("b", style()).named("kid-b")])
}
val kids = Kids()
fun makeKids(): Component = kids

/** A font whose face is told apart by family. */
class Families() : TextFont {
    fun face(family: string, size: f64, weight: int): int = family.size
    fun width(face: int, text: string, start: int, end: int): f64 = f64FromInt(end - start) * 8.0
    fun clusterEnd(text: string, i: int): int = textCodePointEnd(text, i)
    fun lineHeight(face: int): f64 = 20.0
}

fun scopes(): void {
    // Two trees, the same node index in each holding a component: each renders its own.
    var ta = viewTree(themeDefault(), Mono())
    var tb = viewTree(themeDefault(), Mono())
    var r = recorder()
    val unusedA = ta.mount(comp("a", makeReadsA))
    val unusedB = tb.mount(comp("b", makeReadsB))
    ta.update(800.0, 600.0)
    tb.update(800.0, 600.0)
    rendersA = 0
    rendersB = 0
    own.a = 1
    own.b = 1
    ta.update(800.0, 600.0)
    tb.update(800.0, 600.0)
    check(rendersA == 1 && rendersB == 1, "two trees each re-render their own component (a ${rendersA}, b ${rendersB})")

    // A removed component's subscription doesn't reach the node that takes its slot.
    var t = viewTree(themeDefault(), Mono())
    val first = t.mount(comp("a", makeReadsA))
    t.update(800.0, 600.0)
    t.unmount(first)
    val second = t.mount(comp("c", makeReadsC))
    t.update(800.0, 600.0)
    check(second == first, "the slot is reused (so the check below means something)")
    rendersC = 0
    t.renders = 0
    own.a = 2
    t.update(800.0, 600.0)
    check(t.renders == 0 && rendersC == 0, "a State the removed component read doesn't re-render the new one (${t.renders})")
    check(own.^a.readerCount() <= 1, "and its readers don't keep the dead scope after a change (${own.^a.readerCount()})")

    // A key spelled like an unkeyed child's place doesn't take that child's node.
    var u = viewTree(themeDefault(), Mono())
    val unusedKids = u.mount(comp("kids", makeKids))
    u.update(800.0, 600.0)
    val before = u.named("kid-b")
    kids.keyed = true
    u.update(800.0, 600.0)
    check(u.named("kid-b") == before && u.texts.text[before] == "b", "a child keyed \"#1\" doesn't take the unkeyed child's node")

    // useTheme with another font family moves text to its face.
    var v = viewTree(themeDefault(), Families())
    val unusedText = v.mount(text("hello", style()).named("hello"))
    v.update(800.0, 600.0)
    val n = v.named("hello")
    val oldFace = v.texts.face[n]
    val other = themeDefault()
    other.families[0] = "a family with a much longer name"
    v.useTheme(other)
    v.update(800.0, 600.0)
    check(v.texts.face[n] != oldFace, "useTheme with another family moves text to its face")
    return
}

fun adversarial(): void {
    // A name goes with its node: once the node is gone the name finds nothing, even when
    // another node has taken its slot.
    var t = viewTree(themeDefault(), Mono())
    var r = recorder()
    var e = viewInput()
    adv.showFps = true
    adv.showList = false
    adv.extra = 0
    val unusedHud = t.mount(comp("advhud", makeAdvHud))
    frame(t, e, r)
    val fps = t.named("fps")
    check(fps >= 0 && t.texts.text[fps] == "60 fps", "a named node is found")
    adv.showFps = false
    adv.extra = 3
    frame(t, e, r)
    val after = t.named("fps")
    check(after < 0, "a removed node's name finds nothing (it found node $after, which says \"${if (after >= 0) t.texts.text[after] else ""}\")")
    t.setText(t.named("fps"), "59 fps")
    clearRec(r)
    frame(t, e, r)
    check(said(r, "59 fps") < 0 && said(r, "label 0") >= 0 && said(r, "label 1") >= 0 && said(r, "label 2") >= 0, "text set through a removed node's name lands nowhere")

    // A scroller removed in the middle of a drag: the drag ends, and whatever takes its slot isn't scrolled.
    var t2 = viewTree(themeDefault(), Mono())
    var e2 = viewInput()
    adv.showFps = false
    adv.showList = true
    adv.extra = 0
    val unusedHud2 = t2.mount(comp("advhud", makeAdvHud))
    frame(t2, e2, r)
    e2.x = 50.0
    e2.y = 60.0
    e2.pressed = true
    e2.down = true
    frame(t2, e2, r)
    e2.pressed = false
    e2.y = 30.0
    frame(t2, e2, r)
    val l = t2.named("advlist")
    check(l >= 0 && t2.dragScroll == l && near(t2.sy[l], 30.0), "a drag scrolls the list")
    adv.showList = false
    adv.extra = 4
    frame(t2, e2, r)
    e2.y = 10.0
    frame(t2, e2, r)
    var scrolled = 0
    for (n in 0 until t2.sy.size) if (t2.flex.has(n, FLEX_F_LIVE) && t2.sy[n] != 0.0) scrolled = scrolled + 1
    check(t2.dragScroll < 0 && scrolled == 0, "a drag ends with its scroller (drag on node ${t2.dragScroll}, $scrolled live nodes scrolled)")
    e2.down = false
    e2.released = true
    frame(t2, e2, r)
    e2.released = false

    // Unmounted between frames: the regions of the last paint are no longer anything to hover or press.
    var t3 = viewTree(themeDefault(), Mono())
    var e3 = viewInput()
    advPresses = 0
    val mounted = t3.mount(comp("advbutton", makeAdvButton))
    frame(t3, e3, r)
    val ok = t3.named("ok")
    e3.x = t3.ax[ok] + 10.0
    e3.y = t3.ay[ok] + 10.0
    frame(t3, e3, r)
    check(t3.hot == ok, "the pointer is over the button")
    t3.unmount(mounted)
    val unusedSecond = t3.mount(comp("advbutton", makeAdvButton))
    e3.pressed = true
    e3.down = true
    t3.input(e3)
    check(t3.hot < 0 && t3.active < 0, "nothing is hovered or pressed through the regions of an unmounted node (hot ${t3.hot}, active ${t3.active})")
    e3.pressed = false
    e3.down = false
    e3.released = true
    t3.input(e3)
    e3.released = false
    check(advPresses == 0, "and no handler runs ($advPresses presses)")

    // A new theme restyles what is mounted, not only what renders afterwards.
    var t4 = viewTree(themeDefault(), Mono())
    var e4 = viewInput()
    t4.useTheme(themeDefault())
    val unusedButton = t4.mount(comp("advbutton", makeAdvButton))
    clearRec(r)
    frame(t4, e4, r)
    var sawOld = false
    for (c in r.boxRgb) if (c == 0x21262d) sawOld = true
    check(sawOld, "the button is drawn in the theme's fill")
    val other = themeDefault()
    other.button = style().row().height(34.0).fill(0xaa0000, 1.0)
    other.fontSize = 30.0
    t4.useTheme(other)
    clearRec(r)
    frame(t4, e4, r)
    var sawNew = false
    sawOld = false
    for (c in r.boxRgb) {
        if (c == 0xaa0000) sawNew = true
        if (c == 0x21262d) sawOld = true
    }
    check(sawNew && !sawOld, "useTheme restyles a mounted button (new fill $sawNew, old fill $sawOld)")
    t4.useTheme(themeDefault())

    // The change records are for a renderer that takes them: one that doesn't must not be left
    // an ever longer list.
    var t5 = viewTree(themeDefault(), Mono())
    var e5 = viewInput()
    val unusedText = t5.mount(text("0", style()).named("n"))
    for (i in 0 until 6000) {
        t5.setText(t5.named("n"), "$i")
        frame(t5, e5, r)
    }
    check(t5.changes.size <= 3 * VIEW_CHANGES_KEPT, "change records nobody takes don't pile up (${t5.changes.size / 3} records after 6000 frames)")
    return
}

/** Plain States (abla-one's): no reader is known, so a change renders every component again. */
fun plain(): void {
    var t = viewTree(themeDefault(), Mono())
    val unusedPlain = t.mount(comp("plain", makePlainView))
    val unusedCounter = t.mount(comp("counter", makeCounter))
    t.update(800.0, 600.0)
    val first = plainRenders
    val countsBefore = t.renders
    t.update(800.0, 600.0)
    check(plainRenders == first && t.renders == countsBefore, "nothing changed: nothing renders")
    plainModel.label = "two"
    t.update(800.0, 600.0)
    check(plainRenders == first + 1 && t.texts.text[t.named("plain")] == "two", "a plain State's change renders its reader again (${t.texts.text[t.named("plain")]})")
    check(t.renders == countsBefore + 2, "and every other component, as an app renders on the revision (${t.renders - countsBefore})")
    plainModel.label = "two"
    t.update(800.0, 600.0)
    check(plainRenders == first + 1, "writing the same value renders nothing")
    stateTouchAll()
    t.update(800.0, 600.0)
    check(plainRenders == first + 2, "stateTouchAll renders every component again")
    val before = t.renders
    model.count = model.count + 1
    t.update(800.0, 600.0)
    check(t.renders == before + 1 && plainRenders == first + 2, "a Tracked change still renders only its reader")
    return
}

fun main: int {
    counting()
    settings()
    scrollingAndBreakpoints()
    fontsArrive()
    adversarial()
    scopes()
    plain()
    println("tree: $passed passed, $failed failed")
    if (failed == 0) 0 else 1
}
